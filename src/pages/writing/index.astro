---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Arrow from '../../components/Arrow.astro';
import { publishedArticles, formatDate } from '../../lib/articles';
const articles = await publishedArticles();
---
<Layout title="Writing" description="Articles, notes, and observations by Egor Markowskij. Read the latest writing or subscribe through RSS.">
  <PageHeading number="02" label="Writing" title="Thinking out loud" intro="Notes from the process. Ideas worth returning to." />
  <section class="editorial-grid" aria-labelledby="articles-title"><aside class="section-aside"><span class="eyebrow">The reading list</span><h2 id="articles-title">Words,<br /> with intent.</h2><p>Articles and shorter notes, published when they are ready.</p><a href="/rss.xml" class="text-link">Subscribe via RSS <Arrow diagonal /></a></aside><div>{articles.length ? articles.map((article, index) => <a class="article-row" href={`/writing/${article.id}/`}><span class="eyebrow muted">{String(index + 1).padStart(2, '0')} / {formatDate(article.data.pubDate)}</span><h3>{article.data.title}</h3><p>{article.data.description}</p><span class="eyebrow red">Read the article <span aria-hidden="true">↗</span></span></a>) : <div class="empty-writing"><span class="eyebrow red">The first page is still blank</span><span class="empty-quote" aria-hidden="true">“</span><h3>Good thoughts<br />take their time.</h3><p>There are no published articles yet.<br />Come back for the first entry, or follow the RSS feed.</p><a class="text-link" href="/rss.xml">Follow the writing <Arrow diagonal /></a></div>}</div></section>
</Layout>
