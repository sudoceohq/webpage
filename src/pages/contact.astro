---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../lib/site';
---
<Layout title="Contact" description="Contact Egor Markowskij at egor.a.markowskij@sudoceo.com, or find Sudoceo on GitHub.">
  <PageHeading number="04" label="Contact" title="Let’s talk" intro="An idea, a question, or a simple hello. There’s room for all three." />
  <section class="editorial-grid contact-grid" aria-labelledby="contact-methods"><aside class="section-aside"><span class="eyebrow red">An open line</span><h2 id="contact-methods">Start<br /> somewhere.</h2><p>A little context goes a long way. Tell me what you’re thinking about.</p></aside><div><a class="contact-row" href={`mailto:${site.email}`}><span class="eyebrow">01 / Email</span><span class="email-address">{site.email}</span><Arrow diagonal /></a><a class="contact-row" href={site.github}><span class="eyebrow">02 / GitHub</span><span>@sudoceohq</span><Arrow diagonal /></a><a class="contact-row" href={site.linkedin}><span class="eyebrow">03 / LinkedIn</span><span>Egor Markowskij</span><Arrow diagonal /></a></div></section>
</Layout>
