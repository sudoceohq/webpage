---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
---
<Layout>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-meta"><span class="eyebrow"><span class="status-dot"></span> Personal index / 2026</span><span class="eyebrow">A name. An alias. A point of view.</span></div>
    <h1 id="hero-title">Egor<br /><span class="surname">Markowskij<span class="red">.</span></span></h1>
    <div class="hero-bottom">
      <div class="alias-note"><span class="red annotation">↳</span><div><span class="eyebrow">Elsewhere on the internet</span><p>Also known as <strong>Sudoceo.</strong></p></div></div>
      <p class="hero-intro">A personal home for the work,<br class="desktop-break" /> the thinking, and what comes next.</p>
      <a class="circle-link" href="#explore" aria-label="Explore the website"><svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 3v18M5 14l7 7 7-7" stroke="currentColor" stroke-width="1.5"/></svg></a>
    </div>
  </section>
  <section id="explore" class="index-grid" aria-labelledby="index-title">
    <div class="index-note"><span class="eyebrow red">01 — The index</span><h2 id="index-title">A closer<br /> look.</h2><p>Two identities.<br />One place to connect the dots.</p><span class="index-mark" aria-hidden="true">[ E / S ]</span></div>
    <a href="/work/" class="index-card work-card"><div class="card-top flex items-center justify-between"><span class="eyebrow">01 / Work</span><Arrow diagonal /></div><div class="work-art" aria-hidden="true"><span class="art-label">W—01</span><div class="art-frame"><div class="art-inner"><span>W</span></div></div><span class="art-caption">Ideas → execution</span></div><div class="card-bottom"><h3>Work, in focus.</h3><p>Projects & selected work</p></div></a>
    <a href="/writing/" class="index-card writing-card"><div class="card-top flex items-center justify-between"><span class="eyebrow">02 / Writing</span><Arrow diagonal /></div><div class="writing-art" aria-hidden="true"><span class="quote-mark">“</span><span class="art-label">Notes from<br />the process.</span><div class="writing-lines"><i></i><i></i><i></i></div></div><div class="card-bottom"><h3>Thinking out loud.</h3><p>Notes, articles & observations</p></div></a>
  </section>
  <section class="about-strip" aria-labelledby="about-title"><span class="eyebrow">02 — Behind the name</span><div><h2 id="about-title">Egor, in person.<br /><span class="muted">Sudoceo, online.</span></h2><p>A professional name and a digital identity.<br />The same person on both sides of the screen.</p></div><a class="text-link" href="/about/">A little about me <Arrow diagonal /></a></section>
  <section class="contact-strip" aria-labelledby="contact-title"><span class="eyebrow">03 — Start a conversation</span><a href="/contact/" class="contact-heading"><h2 id="contact-title">Say hello<span class="red">.</span></h2><Arrow diagonal /></a><span class="eyebrow contact-note">Good conversations start somewhere.</span></section>
</Layout>
