---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../lib/site';
const projects = [
  { id: 'thriftystack', name: 'ThriftyStack', category: 'Platform / Public source', role: 'Public contributor', description: 'I contribute to the public ThriftyStack repositories while learning platform engineering. ThriftyStack/platform is Argo CD GitOps for the platform clusters. The management cluster file says Proxmox, and a workload cluster file says OCI. That repository includes Helm charts and Vault PKI configuration. ThriftyStack/crossplane is OpenTofu for Authentik groups and OIDC applications. ThriftyStack/applications does not yet contain a deployable workload chart. These repositories are public configuration, not a verified production deployment.', tags: ['Argo CD', 'OpenTofu', 'Vault', 'Authentik', 'Helm'], href: 'https://github.com/ThriftyStack/platform', link: 'Platform repository on GitHub' },
  { id: 'document-recognition', name: 'Document Recognition & Review', category: 'Application / Abasis.AI', role: 'Full-stack development · 2026', description: 'An invoice intake and review application: document uploads, asynchronous OCR, field correction, approval, and exports. My work covered frontend and backend features, automated tests, CI/CD, and Docker Compose deployment preparation.', tags: ['React', 'TypeScript', 'FastAPI', 'PostgreSQL', 'Docker'], href: site.linkedin, link: 'Project background on LinkedIn' },
  { id: 'provider-agnostic-ocr', name: 'Provider-Agnostic OCR Engine', category: 'Engine / Abasis.AI', role: 'Contributor · 2026', description: 'A stateless service that integrates OCR and extraction providers behind a stable API and grounds extracted fields in document geometry. I contributed validation, API contract safeguards, runtime support, and CI and release improvements.', tags: ['Python', 'REST APIs', 'OpenAPI', 'Docker'], href: site.linkedin, link: 'Project background on LinkedIn' },
  { id: 'libracircu', name: 'LibraCircu', category: 'Application / Personal', role: 'Personal project', description: 'A library management application with a book catalog, loans, reservations, staff administration, privacy controls, and Telegram integration. A React interface connects to a Python API and a Telegram bot.', tags: ['React', 'TypeScript', 'FastAPI', 'SQLAlchemy', 'Telegram'], href: undefined, link: 'Source repository is private' },
];
---
<Layout title="Work" description="Selected work by Egor Markowskij. ThriftyStack is the main public project.">
  <PageHeading number="01" label="Work" title="From code to systems" intro="ThriftyStack first. Earlier application work follows." />
  <section class="editorial-grid" aria-labelledby="projects-title">
    <aside class="section-aside"><span class="eyebrow">The project index</span><h2 id="projects-title">Built with<br /> intent.</h2><p>Selected professional and personal work. My role is noted for each project.</p></aside>
    <div>{projects.map((project, index) => <article class="project-row" id={project.id}><div class="project-number eyebrow red">{String(index + 1).padStart(2, '0')} / {project.category}</div><div><h3>{project.name}</h3><p class="eyebrow muted">{project.role}</p><p>{project.description}</p><div class="tag-list flex flex-wrap gap-2">{project.tags.map(tag => <span>{tag}</span>)}</div>{project.href ? <a class="eyebrow" href={project.href}>{project.link} ↗</a> : <span class="eyebrow muted">{project.link}</span>}</div></article>)}</div>
  </section>
  <div class="page-end"><span class="eyebrow">{site.contactHeading}</span><a class="text-link" href="/contact/">{site.contactCta} <Arrow diagonal /></a></div>
</Layout>
