---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
---
<Layout title="Work" description="Public projects and selected work by Egor Markowskij, also known as Sudoceo.">
  <PageHeading number="01" label="Work" title="In the making" intro="A look at the work, with the source close at hand." />
  <section class="editorial-grid" aria-labelledby="projects-title">
    <aside class="section-aside"><span class="eyebrow">The project index</span><h2 id="projects-title">Open<br /> by design.</h2><p>A public repository is a starting point. The details live in the source.</p></aside>
    <div><a class="project-row" href="https://github.com/sudoceohq/argocd"><div class="project-number eyebrow red">01 / Infrastructure</div><div><h3>Management GitOps</h3><p>Argo CD configuration for a Talos management cluster, with Helm charts, staged Vault PKI, and Istio integration.</p><div class="tag-list flex flex-wrap gap-2"><span>Argo CD</span><span>Helm</span><span>Kubernetes</span></div><span class="eyebrow muted">Source: sudoceohq/argocd · README</span></div><Arrow diagonal /></a><div class="editorial-note"><span class="eyebrow red">An evolving index</span><p>More project notes will be added here as they are ready to share.</p></div></div>
  </section>
  <div class="page-end"><span class="eyebrow">Have something in mind?</span><a class="text-link" href="/contact/">Let’s talk <Arrow diagonal /></a></div>
