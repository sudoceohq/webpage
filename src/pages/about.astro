---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../lib/site';
---
<Layout title="About" description="Egor Markowskij in person. Sudoceo online. Meet the person behind the name.">
  <PageHeading number="03" label="About" title="Behind the name" intro="Egor, in person. Sudoceo, online." />
  <section class="about-grid" aria-labelledby="identity-title">
    <div class="identity-art" aria-hidden="true"><span class="eyebrow">Two names / One person</span><div>E<span class="red">/</span>S</div><span class="eyebrow">Egor Markowskij · Sudoceo</span></div>
    <div class="about-copy"><span class="eyebrow red">A short introduction</span><h2 id="identity-title">A name you can meet.<br />An alias you can find.</h2><p>I’m Egor Markowskij. You may also know me as Sudoceo.</p><p>This is my personal corner of the internet: a place for my work, writing, and conversations that start with a shared curiosity.</p><dl class="identity-details"><div><dt>Professional name</dt><dd>Egor Markowskij</dd></div><div><dt>Digital identity</dt><dd>Sudoceo</dd></div><div><dt>Online</dt><dd><a href={site.github}>GitHub ↗</a></dd></div></dl><a class="text-link" href="/contact/">Start a conversation <Arrow diagonal /></a></div>
  </section>
</Layout>
