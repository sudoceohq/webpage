---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../lib/site';
---
<Layout title="About">
  <PageHeading number="03" label="About" title="Behind the name" intro="Egor, in person. Sudoceo, online." />
  <section class="about-grid" aria-labelledby="identity-title">
    <div class="identity-art" aria-hidden="true"><span class="eyebrow">Two names / One person</span><div>E<span class="red">/</span>S</div><span class="eyebrow">Egor Markowskij · Sudoceo</span></div>
    <div class="about-copy"><span class="eyebrow red">A short introduction</span><h2 id="identity-title">Applications.<br />Infrastructure.<br />Ownership.</h2><p>I’m Egor Markowskij. You may also know me as Sudoceo.</p><p>{site.role}. I am also a robotics student based in Poznań, Poland. I work with Linux, infrastructure as code, containers, and Kubernetes, and I have also built with React, TypeScript, Python, and FastAPI.</p><p>At Abasis.AI, I worked across an OCR application’s frontend, backend, tests, and delivery preparation, and contributed to its separate OCR engine. Outside that contract, I contribute to ThriftyStack in public.</p><p>I’m interested in secure delivery, hybrid networking, secrets management, observability, and reliable recovery. I’m open to junior DevOps and platform roles, and to collaboration.</p><dl class="identity-details"><div><dt>Professional name</dt><dd>Egor Markowskij</dd></div><div><dt>Digital identity</dt><dd>Sudoceo</dd></div><div><dt>Online</dt><dd><a href={site.github}>GitHub ↗</a> · <a href={site.linkedin}>LinkedIn ↗</a></dd></div></dl><a class="text-link" href="/contact/">{site.contactCta} <Arrow diagonal /></a></div>
  </section>
  <section class="editorial-grid" aria-labelledby="background-title">
    <aside class="section-aside"><span class="eyebrow red">The background</span><h2 id="background-title">Experience<br /> & learning.</h2><p>Professional history and ongoing studies, drawn from my LinkedIn profile.</p></aside>
    <div>
      <article class="project-row"><span class="project-number eyebrow red">01 / Experience</span><div><h3>Abasis.AI</h3><p class="eyebrow muted">Full Stack Engineer · June–August 2026 · Remote</p><p>OCR application development across React, TypeScript, Python, FastAPI, and PostgreSQL. Authentication, access control, document review, approvals, exports, automated testing, CI/CD, and deployment tooling.</p></div></article>
      <article class="project-row"><span class="project-number eyebrow red">02 / Experience</span><div><h3>Volkswagen Poznan</h3><p class="eyebrow muted">Practitioner · March 2026 · On-site</p></div></article>
      <article class="project-row"><span class="project-number eyebrow red">03 / Education</span><div><h3>Robotics studies</h3><p>ZS1 im. Powstańców Wielkopolski w Swarzędzu</p><p class="eyebrow muted">September 2022–June 2028 · In progress</p></div></article>
      <article class="project-row"><span class="project-number eyebrow red">04 / Learning</span><div><h3>Anthropic courses</h3><ul class="course-list"><li>Building with the Claude API · August 2026</li><li>Introduction to subagents · July 2026</li><li>Claude Code in Action · July 2026</li><li>Introduction to Model Context Protocol · June 2026</li><li>Introduction to agent skills · June 2026</li></ul><a class="eyebrow" href={site.linkedin}>Certificates listed on LinkedIn ↗</a></div></article>
      <article class="project-row"><span class="project-number eyebrow red">05 / Languages</span><div><h3>Across languages</h3><p>English — professional working proficiency<br />Polish — elementary proficiency<br />Russian — native or bilingual proficiency</p></div></article>
    </div>
  </section>
</Layout>
